# Names only, apart from one non-secret default below. Never commit secret values. Generate local secrets with:  openssl rand -base64 32
# Copy to .env and fill in for local development (see README.md).
NODE_ENV=
APP_BASE_URL=
DATABASE_URL=
VALKEY_URL=
BETTER_AUTH_SECRET=
IDENTIFIER_HASH_KEY=
TOTP_ENCRYPTION_KEY=
KYC_ENCRYPTION_KEY=
REALTIME_JOIN_TOKEN_SECRET=
# <kid>:<base64 32 bytes>[,<previous kid>:<base64 32 bytes>]; `pnpm env:init` adds a local one
CATALOG_CURSOR_KEYS=
# Not a secret: the image-helper socket. This is its built-in default; an absolute path is required
IMAGE_HELPER_SOCKET_PATH=/run/helper/helper.sock
TRUSTED_ORIGINS=
EMAIL_TRANSPORT=
LOG_LEVEL=
REALTIME_PORT=
REALTIME_HOST=
# Public variables (the only ones that may reach the browser) start with PUBLIC_
PUBLIC_APP_NAME=
PUBLIC_REALTIME_URL=
# Used by docker-compose.dev.yml only
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
