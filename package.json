{
  "name": "cholo-shikhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "dev:worker": "node src/worker/main.ts",
    "dev:image-helper": "PROCESS_ROLE=image-helper node src/image-helper/main.ts",
    "build": "vite build",
    "start": "node scripts/serve.ts",
    "db:up": "docker compose --env-file .env -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose --env-file .env -f docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed-demo": "node scripts/seed-demo.ts --hide-e2e",
    "db:seed-activity": "node scripts/seed-demo-activity.ts",
    "db:seed-bank": "node scripts/seed-question-bank.ts",
    "db:seed-staff": "node scripts/seed-demo-staff.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/i18n-check.ts",
    "smoke": "node scripts/smoke.ts",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm i18n:check && pnpm test:coverage && pnpm build && pnpm smoke",
    "env:init": "node scripts/env-init.ts",
    "identity:bootstrap-admin": "node scripts/bootstrap-admin.ts",
    "dev:realtime": "node src/realtime/main.ts"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "9.3.1",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "iovalkey": "0.4.0",
    "lucide-react": "1.70.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
